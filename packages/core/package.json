{
  "name": "@agentstxtdev/herald-core",
  "version": "0.2.5",
  "description": "Core generators behind the herald CLI (@agentstxtdev/herald). Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "publint": "publint"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "keywords": [
    "llms-txt",
    "robots-txt",
    "agents-txt",
    "agents-json",
    "agent-map",
    "llm",
    "ai-crawler"
  ],
  "license": "Apache-2.0",
  "homepage": "https://agents-txt.com",
  "bugs": {
    "url": "https://github.com/agents-txt/herald/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agents-txt/herald.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

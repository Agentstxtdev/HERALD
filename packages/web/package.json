{
  "name": "@herald/addon",
  "version": "0.1.0",
  "description": "Drop-in middleware to make any website LLM-ready and monetizable by AI agents via x402",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "import": "./dist/nextjs.js",
      "require": "./dist/nextjs.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js",
      "require": "./dist/dev.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "publint": "publint"
  },
  "dependencies": {
    "@herald/core": "workspace:*"
  },
  "peerDependencies": {
    "express": ">=5.2.1",
    "next": ">=15.0.0",
    "hono": ">=4.12.18",
    "mppx": ">=0.6.16",
    "stripe": ">=20.0.0"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "next": { "optional": true },
    "hono": { "optional": true },
    "mppx": { "optional": true },
    "stripe": { "optional": true }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "next": ">=15.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "x402",
    "llms-txt",
    "robots-txt",
    "agents-txt",
    "ai-payment",
    "http-402",
    "open-standard",
    "express-middleware",
    "nextjs"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentstxt/agents.txt"
  }
}

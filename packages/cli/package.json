{
  "name": "@herald/cli",
  "version": "0.1.0",
  "description": "CLI to make any website agent-ready: robots.txt, llms.txt, agents.txt, agents.json, x402 + MPP payments",
  "type": "module",
  "bin": {
    "herald": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "publint": "publint"
  },
  "dependencies": {
    "@herald/core": "workspace:*",
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "herald",
    "llms-txt",
    "agents-txt",
    "agents-json",
    "ai-crawler",
    "x402",
    "mpp",
    "cli"
  ],
  "license": "Apache-2.0",
  "homepage": "https://agentstxt.dev",
  "bugs": { "url": "https://github.com/agentstxtdev/herald/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentstxtdev/herald.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

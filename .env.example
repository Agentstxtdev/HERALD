# ── Site ─────────────────────────────────────────────────────────────────────
# Used by project-probe (init wizard) and the Express / Next.js examples
SITE_URL=https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com
PORT=3000

# ── x402 — Crypto micropayments (per-request) ─────────────────────────────
# EVM wallet — receives USDC on Base (eip155:8453), Ethereum (eip155:1), etc.
# Public address only — no private keys on the server.
# Alias: TREASURY_ADDRESS is also detected by the init wizard.
EVM_ADDRESS=0xYourEVMWalletAddress
# TREASURY_ADDRESS=0xYourEVMWalletAddress   # alternative key name

# Solana wallet — receives USDC SPL tokens (base58 address)
SOLANA_ADDRESS=YourSolanaBase58Address

# ── MPP — Machine Payments Protocol (session-based fiat + USDC) ─────────────
# Requires: npm install mppx

# Tempo wallet — receives USDC.e via the Tempo stablecoin rail.
# Same address as EVM_ADDRESS if your wallet supports Tempo; otherwise a
# dedicated Tempo wallet (0x...). Used by agentic.config.js and the site worker.
TREASURY_TEMPO=0xYourTempoWalletAddress

# Stripe — enables fiat card support via Shared Payment Tokens (SPT).
# Obtain STRIPE_NETWORK_ID from your Stripe dashboard under Business Network.
# Omit both to use Tempo USDC-only.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_NETWORK_ID=profile_...

# MPP shared secret — 32-byte base64 string for HMAC challenge binding.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MPP_SECRET_KEY=your_mpp_secret_key

# ── Firecrawl — Richer llms.txt generation ────────────────────────────────
# Free tier available at firecrawl.dev — no credit card required.
# When set, the init wizard defaults to the firecrawl content driver.
FIRECRAWL_API_KEY=fc-...

# agents.json pricing hint (shown to agents before they attempt payment)
ENABLE_PAYMENTS=false
X402_PRICE_AMOUNT=0.001
X402_PRICE_TOKEN=USDC       # optional, defaults to nothing if unset
MPP_PRICE_AMOUNT=0.001
MPP_PRICE_TOKEN=USD         # optional
